# ── Legend ─────────────────────────────────────────────────────────────────
#   [必填] Required — must be configured before startup
#   [选填] Optional — safe to leave unset (default applies / feature stays off)
# Copy this file to .env and fill in your values. Secrets go into .env only —
# never commit them.

# ── Database ─────────────────────────────────────────────────────────────
# [选填] Full SQLAlchemy URL — highest-priority connection config. When set,
# it wins over both MSSQL_CONNECTION_STRING and the DB_* fields below.
# Supported dialects (async app driver / sync alembic driver):
#   SQL Server: mssql+aioodbc://sa:pass@host:1433/db?driver=ODBC+Driver+17+for+SQL+Server
#   PostgreSQL: postgresql+asyncpg://user:pass@host:5432/db
#   MySQL:      mysql+aiomysql://user:pass@host:3306/db   (create the DB with
#               utf8mb4 + utf8mb4_0900_bin collation — see docker-compose.yml)
#   SQLite:     sqlite+aiosqlite:///C:/path/to/dev.db   (local dev/tests only)
# DATABASE_URL=

# [必填] SQL Server connection (individual fields) — used when DATABASE_URL
# is unset (default MSSQL deployment; byte-identical URL to pre-multi-DB builds)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=agentsuniverse
DB_USER=sa
DB_PASSWORD=YourPassword
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_CERT=true

# [选填] Connection pool tuning (defaults: 10 / 20 / 30)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# [选填] Legacy: full mssql+aioodbc connection string. Lower priority than
# DATABASE_URL; kept for compatibility with deployments that could not use
# the DB_* fields (e.g. non-standard drivers).
# MSSQL_CONNECTION_STRING=

# ── Security ──────────────────────────────────────────────────────────────
# [必填] Replace with a random 32-char secret (token encryption,
# session signing, OAuth state hashing all derive from this)
SECRET_KEY=change-me-to-a-random-32-char-secret

# ── Redis ─────────────────────────────────────────────────────────────────
# [必填] Redis URL for sessions + active-user tracking
REDIS_URL=redis://localhost:6379/0
# [选填] Redis password (omit when the server has no auth)
# REDIS_PASSWORD=

# ── App URLs ──────────────────────────────────────────────────────────────
# [必填] Public URLs of API and web UI (CORS, OAuth callback, redirects)
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# [选填] Deploy behind a sub-path (e.g. /agents-universe)
# APP_ROOT_PATH=

# ── Storage ───────────────────────────────────────────────────────────────
# [必填] ABSOLUTE path to directory where sub-project workspaces are stored.
# Each project gets its own subdirectory: {PROJECTS_ROOT}/{slug}/knowledge/
# Must exist on disk before starting the API (a warning is logged otherwise).
# Windows:  PROJECTS_ROOT=C:\Users\you\projects\agent-projects
# Linux:    PROJECTS_ROOT=/data/projects
# Docker:   Set to the HOST path here; container maps it to /app/projects
PROJECTS_ROOT=/data/projects

# [选填] Max upload size in MB (default 10)
# MAX_UPLOAD_SIZE_MB=10

# ── Auth (local dev bypass) ───────────────────────────────────────────────
# [选填] Dev-only: skip real login. NEVER enable in production.
AUTH_BYPASS_ENABLED=true
AUTH_BYPASS_USER_ID=dev-user
OAUTH_SECURE_COOKIE=false

# ── OAuth SSO (production) ────────────────────────────────────────────────
# [选填] Uncomment and fill these to enable enterprise SSO (disable AUTH_BYPASS above).
# Endpoints are auto-discovered from {OAUTH_SSO_DOMAIN}/.well-known/openid-configuration
# OAUTH_SSO_DOMAIN=https://sso.example.com
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# OAUTH_ACR_VALUES=
# OAUTH_SCOPE=openid profile email
# [选填] Verify the SSO server's TLS cert (default false — self-hosted SSO
# like Keycloak/Casdoor often uses self-signed certs)
# OAUTH_SSL_VERIFY=false
# [选填] Lifetime (seconds) of the OAuth state nonce, duplicate-callback
# recovery cache, and anchor cookie — must outlive a full login round-trip.
# OAUTH_STATE_TTL=1800

# ── Session ───────────────────────────────────────────────────────────────
# [选填] Session / cookie / active-user window tuning (defaults shown)
# SESSION_TTL=86400
# AUTH_COOKIE_NAME=x-auth-token
# ACTIVE_USERS_WINDOW=300

# ── TLS / SSL ────────────────────────────────────────────────────────────
# [选填] Verify TLS certs for LLM providers and outbound tools.
# Default: false (corporate proxies often use internal CA). Set true in production.
LLM_SSL_VERIFY=false
# [选填] Verify TLS certs for Playwright browser requests (default true;
# set false to allow self-signed certs)
# BROWSER_SSL_VERIFY=true

# ── Outbound Proxy ───────────────────────────────────────────────────────
# [选填] Proxy applied to all LLM provider calls at startup
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# [选填] Extra NO_PROXY entries from .env (kept even if system NO_PROXY differs)
# APP_NO_PROXY=

# ── Logging ───────────────────────────────────────────────────────────────
# [选填] Log level and format (json | human)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ── Sandbox Network Policy ────────────────────────────────────────────────
# [选填] Network policy for Python code executed by agents (code_executor).
#   (unset)   -> allow all network access (default) — required for full
#                Playwright functionality: file downloads, screen recording,
#                any outbound API the agent's script needs
#   localhost  -> loopback only (127.0.0.1, ::1, localhost) — sandboxed code
#                may still reach the app itself, but nothing else
#   none       -> block all sockets (strictest; outbound calls fail)
# SANDBOX_NETWORK=

# ── System Default Model ──────────────────────────────────────────────────
# [选填] OpenAI-compatible fallback when a user has no personal model configs.
# Always treated as a base URL (code appends /v1/chat/completions as needed).
# SYSTEM_DEFAULT_MODEL_ID=gpt-4o
# SYSTEM_DEFAULT_BASE_URL=https://api.openai.com
# SYSTEM_DEFAULT_API_KEY=

# ── Integrations (Jira / Confluence / Git) ────────────────────────────────
# All entries below are [选填]. They only set SYSTEM-LEVEL default base URLs;
# each user's credentials live encrypted in the DB (user_tokens table,
# AES-256-GCM) and are configured per-user in the web UI — never in .env.

# Jira + Confluence share one Atlassian base URL. The auth mode is
# auto-derived from the domain — nothing else to configure:
#   Cloud:  https://your-org.atlassian.net  → basic auth (user provides
#           email + API token), no sub-paths
#   Server: https://jira.your-company.com   → bearer auth (user provides PAT),
#           /jira and /confluence sub-paths applied automatically
# Uncomment when you run Jira/Confluence. With no value, the integration
# list shows no default URL (users can still set their own).
# ATLASSIAN_BASE_URL=https://your-org.atlassian.net
# [选填] Verify TLS for Jira/Confluence (default false)
# ATLASSIAN_SSL_VERIFY=true

# Git repos — GitHub.com or GitHub Enterprise Server.
#   https://github.com            → default; REST API auto-routed to api.github.com
#   https://git.your-company.com  → GHE; REST API auto-routed to /api/v3
# Leave unset for GitHub.com (default). Token stays per-user in the DB.
# GIT_BASE_URL=https://github.com
# [选填] Verify TLS for GHE/GitHub (default false)
# GIT_SSL_VERIFY=true

# ── SSRF protection (agent outbound calls) ────────────────────────────────
# [选填] Opt-in DNS-level SSRF checks for agent HTTP tools (default off).
# When enabled, every outbound URL the agent requests is resolved and
# validated against internal ranges.
# SSRF_ENABLED=true
# [选填] Let the api_request tool reach loopback/private ranges
# (e.g. Kong admin, local Ollama). Default: blocked.
# THIRD_PARTY_API_ALLOW_PRIVATE=true
